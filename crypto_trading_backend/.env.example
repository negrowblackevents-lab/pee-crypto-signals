# Trading safety
PAPER_TRADING=true
LIVE_TRADING=false

# Binance (optional; only needed for private endpoints / live trading)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Risk management
MAX_POSITION_PCT=0.05
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.06
MAX_DAILY_TRADES=5
MIN_SIGNAL_SCORE=75.0

# App
UPDATE_INTERVAL_SECONDS=300

# New coin scanner
NEW_COIN_MIN_VOLUME_USD=5000000
NEW_COIN_MIN_CHANGE_PCT=15.0
NEW_COIN_MAX_RESULTS=10

